PROJECT_NAME           = "bash-doxygen integration"
OUTPUT_DIRECTORY       = tmp/doxygen-integration
CREATE_SUBDIRS         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
INPUT                  = tests/doxygen/integration-fixture.bash
RECURSIVE              = NO
FILE_PATTERNS          = *.bash
FILTER_PATTERNS        = *.bash="$(AWK_BIN) -f $(DOXYGEN_BASH_FILTER) -- --strict --compact"
FILTER_SOURCE_FILES    = YES
EXTENSION_MAPPING      = bash=C++
EXTRACT_ALL            = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
