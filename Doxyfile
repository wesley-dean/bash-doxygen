PROJECT_NAME           = "bash-doxygen"
PROJECT_BRIEF          = "Reference documentation for bash-doxygen"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
INPUT                  = README.md \
                         doxygen-bash.awk \
                         tests/run-tests.sh \
                         doc/adr \
                         doc/decisions.md
RECURSIVE              = YES
FILE_PATTERNS          = *.awk \
                         *.sh \
                         *.bash \
                         *.md
EXCLUDE                = dist \
                         vendor \
                         doc/reference \
                         tests/fixtures \
                         tests/expected \
                         tests/diagnostics
EXCLUDE_PATTERNS       = */dist/* \
                         */vendor/* \
                         */doc/reference/* \
                         */tests/fixtures/* \
                         */tests/expected/* \
                         */tests/diagnostics/*
EXTENSION_MAPPING      = awk=C++ \
                         sh=C++ \
                         bash=C++
FILTER_PATTERNS        = *.awk=$(AWK_DOXYGEN_FILTER) \
                         *.sh=$(BASH_DOXYGEN_FILTER) \
                         *.bash=$(BASH_DOXYGEN_FILTER)
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
